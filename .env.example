# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Public anon key only. Never the service_role key.
# Without these the app runs in demo mode on mock data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Institution id that receives enrollment requests from the public form.
NEXT_PUBLIC_GANLI_INSTITUTION_ID=YOUR-INSTITUTION-ID
